{
  "name": "@moamen-r/extreme-claude",
  "version": "1.0.8",
  "description": "Turnkey 1-click cross-platform installer for Claude Code & full AI engineering ecosystem",
  "main": "bin/index.js",
  "bin": {
    "extreme-claude": "bin/index.js"
  },
  "scripts": {
